# Reproducible, distributable cross-build environment for mainline Klipper on the Ender 3 V3 KE.
#
# MULTI-STAGE so the *published* image carries ONLY the two cross toolchains plus the runtime
# needed to use them — not crosstool-ng's ~55 GB of build scratch (downloaded sources, object
# files, intermediate gcc/glibc build trees). The single-stage predecessor shipped all of that:
# a 61 GB image for 3.5 GB of actual toolchain.
#
#   toolchain-base   base + host build deps + crosstool-ng + ct-build wiring   (shared)
#     |- mips-build    FROM base; ct-build all --target mips -> /opt/x-tools/mipsel-buildroot-linux-gnu
#     \- arm-build     FROM base; ct-build all --target arm  -> /opt/x-tools/arm-none-eabi
#   final            runtime deps + COPY /opt/x-tools from BOTH builders        (the shipped image)
#
# The two builders derive from the same base and are independent: editing one toolchain's
# config/patch can't invalidate the other (each builder owns its own fragment), and BuildKit can
# build them in parallel. Their build scratch never enters `final`.
#
# Reproducibility (unchanged): the *toolchain* is reproducible from crosstool-ng's pinned component
# versions + checksums — the from-source build is verified byte-identical across independent runners
# in CI (RFC B4). It does NOT come from the image layers (the zypper layers are not byte-reproducible,
# see the note below); the image is a cache, not the anchor.
#
# Build:   ./tools/build.py image       (builds image incl. toolchains; ~20-40 min cold)
# Backup:  ./tools/build.py snapshot    (copy toolchain -> named volume, dev safety net)
# Use:     ./tools/build.py artifacts   (build device artifacts with this image)

# Base image: digest-pinned (shared by the builders and the final stage), not `:latest`, for an
# auditable and stable starting point. This is the registry.opensuse.org index (multi-arch) digest
# that opensuse/tumbleweed:latest resolved to on 2026-06-06. We fully-qualify to
# registry.opensuse.org — the authoritative opensuse registry — on purpose: it has no docker.io
# anonymous-pull CI rate limits, and docker.io carries a *different* rolling snapshot (different
# digest) of the same tag. Bump deliberately by re-resolving the tag's index digest
# (`curl -sI .../v2/opensuse/tumbleweed/manifests/latest` -> Docker-Content-Digest).
ARG BASE=registry.opensuse.org/opensuse/tumbleweed@sha256:ffe0ae6f22739f88da193678907f4e72b1b609bc643532a15c91026a25f22e42

# ============================================================================================
# Stage 1: toolchain-base — host build deps + crosstool-ng + ct-build wiring (shared by builders)
# ============================================================================================
FROM ${BASE} AS toolchain-base

# Host build deps for crosstool-ng + glibc/gcc + ccache. Both target toolchains (MIPS host and
# arm-none-eabi for the MCU firmware) are built from source by ct-build below — no distro cross
# packages (they can't be durably pinned on a rolling distro).
# `dup` first: a rolling base image can be a newer snapshot than the current repo mirror, which
# breaks devel/runtime version matches (e.g. ncurses-devel vs libncurses6). dup reconciles to one
# consistent snapshot before installing.
# NOTE (reproducibility): this `zypper dup` + install layer is deliberately NOT byte-reproducible —
# it installs whatever package versions the mirror serves at build time. This is acknowledged and
# accepted: the image is only a *cache*, and the reproducibility anchor is the from-source
# crosstool-ng toolchain build, verified byte-identical across independent runners (RFC B4) — not the
# image layers. Do NOT try to "fix" this by pinning every package or dropping `dup`; pinning a rolling
# distro durably is infeasible, and dropping dup reintroduces the devel/runtime mismatch above.
RUN zypper -n --gpg-auto-import-keys refresh \
 && zypper -n dup --no-recommends --auto-agree-with-licenses \
 && zypper -n install --no-recommends \
      gcc gcc-c++ gcc13 gcc13-c++ make patch automake autoconf libtool gettext-tools \
      bison flex texinfo help2man gperf ncurses-devel ccache \
      curl wget tar xz bzip2 gzip unzip which findutils file gawk sed rsync python3 git \
      glibc-devel \
 && zypper clean -a

# --- crosstool-ng (pinned release, checksum-verified) ---
ARG CTNG_VERSION=1.28.0
RUN set -eux; cd /tmp; \
    base="https://github.com/crosstool-ng/crosstool-ng/releases/download/crosstool-ng-${CTNG_VERSION}"; \
    curl -fsSLO "${base}/crosstool-ng-${CTNG_VERSION}.tar.xz"; \
    curl -fsSLO "${base}/crosstool-ng-${CTNG_VERSION}.tar.xz.sha512"; \
    sha512sum -c "crosstool-ng-${CTNG_VERSION}.tar.xz.sha512"; \
    tar xf "crosstool-ng-${CTNG_VERSION}.tar.xz"; \
    cd "crosstool-ng-${CTNG_VERSION}"; \
    ./configure --prefix=/opt/ctng; make -j"$(nproc)"; make install; \
    cd /; rm -rf /tmp/crosstool-ng-*
ENV PATH=/opt/ctng/bin:$PATH

# crosstool-ng refuses to run as root. Fixed uid/gid so the build-cache mounts in the builders own
# cleanly. The per-toolchain fragments + the mips glibc patch are NOT copied here — they live in the
# builder that uses them, so editing one toolchain's config can't invalidate the other.
RUN groupadd -g 1000 ct && useradd -m -u 1000 -g 1000 ct \
 && mkdir -p /opt/x-tools /home/ct/src /home/ct/.ccache /home/ct/build /opt/ctng-cfg \
 && chown -R ct:ct /opt/x-tools /home/ct
COPY ct_build.py /usr/local/bin/ct-build
RUN chmod +x /usr/local/bin/ct-build

# ============================================================================================
# Stage 2: mips-build — the MIPS host toolchain (device ABI). The slow one.
# ============================================================================================
FROM toolchain-base AS mips-build
COPY crosstool-ng.fragment /opt/ctng-cfg/crosstool-ng.fragment
# Lower glibc's MIPS nan2008 minimum-kernel floor (4.5.0 -> 4.4.0) to match the device's
# Ingenic 4.4.94 kernel; ct-ng auto-applies bundled patches from this dir. (MIPS-only: arm uses newlib.)
COPY glibc-patches/0100-mips-nan2008-min-kernel-4.4.patch \
     /opt/ctng/share/crosstool-ng/packages/glibc/2.29/
USER ct
WORKDIR /home/ct
# Cache mounts persist downloads + ccache across rebuilds, so re-runs don't re-download/recompile.
# ct-build validates the result (the device loader ld-linux-mipsn8.so.1) and fails if wrong.
RUN --mount=type=cache,target=/home/ct/src,uid=1000,gid=1000 \
    --mount=type=cache,target=/home/ct/.ccache,uid=1000,gid=1000 \
    ct-build all --target mips

# ============================================================================================
# Stage 3: arm-build — arm-none-eabi bare-metal toolchain (newlib) for the MCU firmware.
# ============================================================================================
FROM toolchain-base AS arm-build
COPY crosstool-ng-arm.fragment /opt/ctng-cfg/crosstool-ng-arm.fragment
USER ct
WORKDIR /home/ct
# ct-build validates the result (a Cortex-M3 object) and fails if wrong.
RUN --mount=type=cache,target=/home/ct/src,uid=1000,gid=1000 \
    --mount=type=cache,target=/home/ct/.ccache,uid=1000,gid=1000 \
    ct-build all --target arm

# ============================================================================================
# Stage 4: final — the shipped image. Only the two toolchains + the runtime to use them.
#
# crosstool-ng, its host build deps (bison/flex/gperf/*-devel/ccache/host gcc/...), and ~55 GB of
# build scratch are all left behind in the builders. The cross compilers are self-contained: every
# toolchain binary needs only glibc from the host (libc.so.6/libm.so.6 — companion gmp/mpfr/mpc/isl
# libs are statically linked; verified via ldd). The artifact build (tools/build.py artifacts) needs
# make + python3 (klipper Kconfig + orchestrator, stdlib only) + git (SOURCE_DATE_EPOCH) and the
# usual Makefile shell helpers; `ct-build emit-versions` is pure-python (no toolchain required).
# ============================================================================================
FROM ${BASE} AS final

RUN zypper -n --gpg-auto-import-keys refresh \
 && zypper -n dup --no-recommends --auto-agree-with-licenses \
 && zypper -n install --no-recommends \
      make python3 git cpp \
      which findutils file gawk sed grep tar xz gzip bzip2 \
 && zypper clean -a
# `cpp` (host C preprocessor, NOT full gcc): klipper/katapult preprocess their linker
# scripts (armcm_link.ld) with the bare host `cpp` — it's text macro expansion of the .ld,
# not target compilation, so the host preprocessor is correct and the cross gcc isn't used here.

# The two built toolchains (each self-contained: gcc, binutils, glibc/newlib, target libs).
COPY --from=mips-build /opt/x-tools/mipsel-buildroot-linux-gnu /opt/x-tools/mipsel-buildroot-linux-gnu
COPY --from=arm-build  /opt/x-tools/arm-none-eabi              /opt/x-tools/arm-none-eabi
# ct-build for `emit-versions` (pure-python, stdlib-only, reads pinned versions from its own dict).
COPY ct_build.py /usr/local/bin/ct-build
RUN chmod +x /usr/local/bin/ct-build

ENV CROSS_TOOLCHAIN=/opt/x-tools/mipsel-buildroot-linux-gnu
ENV PATH=/opt/x-tools/mipsel-buildroot-linux-gnu/bin:/opt/x-tools/arm-none-eabi/bin:$PATH
WORKDIR /work
